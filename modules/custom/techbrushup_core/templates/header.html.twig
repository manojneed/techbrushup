           {# Check if the user is authenticated #}
          {% if user.isauthenticated %}
          {% set name = user.displayname|trim %}
          {% if name is not empty %}
            {% set words = name|split(' ') %}
            {% set initials = '' %}
            {% for word in words %}
              {% set initials = initials ~ word|first|upper %}
            {% endfor %}
          {% else %}
            {% set initials = '?' %}
          {% endif %}
          <div class="profile-group">
            <div class="flex items-center gap-2 cursor-pointer">
              <div class="w-9 h-9 rounded-full bg-linear-to-r from-indigo-500 to-purple-600 flex items-center justify-center text-white font-semibold shadow-md hover:shadow-lg transition-all">{{ initials }}</div>
              <span class="max-xl:hidden lg:inline-block text-sm font-medium text-slate-700">{{ user.displayname }}</span>
              <svg class="profile-icon w-4 h-4 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
            <div class="profile-dropdown right-0 w-80 rounded-2xl border border-slate-200 bg-white/95 backdrop-blur-sm shadow-2xl">
              <div class="bg-linear-to-r from-indigo-500 to-purple-600 px-6 py-5">
