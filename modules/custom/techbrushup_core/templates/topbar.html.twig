<div class="topnav">
    <div class="logo">
        {{ drupal_block('system_branding_block', {label: '', use_site_name: false, use_site_slogan: false}) }}
    </div>
    <div class="top-menu" id="top-menu">{{ drupal_menu('top') }}</div>
    <div class="default-search"> {{ drupal_block('search_form_block') }}</div>
    <div class="hamburger" id="hamburger">
      <div class="line"></div>
      <div class="line"></div>
      <div class="line"></div>
    </div>
   
 {# Check if the user is authenticated #}
{% if user.isauthenticated %}
  <div class="user-menu">
    {# User avatar and name #}
    <button class="user-menu-toggle">
      <img src="{{ user_picture_url }}" alt="{{ user.displayname }}" class="user-avatar">
      <span class="user-name">{{ user.displayname }}</span>
      <span class="dropdown-arrow">▼</span>
    </button>

    {# Dropdown menu #}
    <ul class="user-dropdown">
      <li><a href="{{ path('user.page') }}">My Profile</a></li>
      <li><a href="{{ path('user.logout') }}">Log Out</a></li>
      <li><a href="{{ path('entity.user.edit_form', {'user': user.id}) }}">Edit Profile</a></li>
    </ul>
  </div>
{% else %}
  {# Show login/register links for anonymous users #}
    <div class="col-2">
        <a href="/user/login"><button type="button" class="signin">Sign in</button></a>
        <a href="/user/login"><button type="button" class="signup">Sign-up</button></a>
    </div>
{% endif %}
</div>
<div class="main-menu">
    <div class="left-arrow">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512">
            <path
                d="M41.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 256 246.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"
                fill="#fff" />
        </svg>
    </div>
    {{ drupal_menu('main') }}
    <div class="right-arrow active">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512">
            <path
                d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"
                fill="#fff" />
        </svg>
    </div>
</div>
 </div>